<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:class="clr-namespace:BSUIRScheduleDESK.Classes"
                    xmlns:control="clr-namespace:BSUIRScheduleDESK.Controls"
                    xmlns:lang="clr-namespace:BSUIRScheduleDESK.Langs">

    <DataTemplate x:Key="NormalLessonPlate" DataType="{x:Type class:Lesson}">
        <Border Background="{DynamicResource Schedule.Background.Static}"
                Width="Auto"
                Height="Auto"
                BorderThickness="0,0.4,0,0.4"
                BorderBrush="{DynamicResource Schedule.BorderBrush.Static}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        x:Name="PART_TypeBorder"/>
                <control:ScheduleTime Grid.Column="1"
                                      StartTimeFontSize="14"
                                      Margin="2,0,0,0"
                                      x:Name="PART_ScheduleTime"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" 
                                Grid.Row="0"
                                Margin="10,0,0,0"
                                x:Name="PART_SubjectInfo">
                        <TextBlock Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Center"
                                   Cursor="Help"
                                   x:Name="PART_SubjectName">
                            <TextBlock.ToolTip>
                                <ToolTip Placement="Top" 
                                         HasDropShadow="True" 
                                         Style="{DynamicResource ToolTipStyle}" 
                                         MaxWidth="200">
                                    <TextBlock TextWrapping="Wrap"
                                               x:Name="PART_ToolTipLabel"/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                </TextBlock>
                        <TextBlock Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="5,0"
                                   x:Name="PART_AbbrevLabel"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="10,0,0,0"
                                x:Name="PART_Announcement">
                        <Path Data="{DynamicResource noteIcon}"
                              Stretch="Fill"
                              Fill="{DynamicResource Schedule.Text.Foreground.Static}"
                              Width="13.5"
                              Height="13.5"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static lang:Language.AnnouncementCaps}"
                                   Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="5,0"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Grid.Row="1"
                               x:Name="PART_AnnouncementText"/>
                    <StackPanel Orientation="Horizontal" 
                                Grid.Row="2"
                                Margin="10,0,0,0">
                        <TextBlock Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                                   VerticalAlignment="Center"
                                   x:Name="PART_DatesWeeksLabel"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                                   FontWeight="DemiBold"
                                   Margin="5,0"
                                   x:Name="PART_BoldDatesWeeksLabel"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3"
                               Foreground="{DynamicResource Schedule.Note.Foreground.Static}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="10,0"
                               x:Name="PART_NoteLabel"/>
                </Grid>
                <control:EmployeeGroups Grid.Column="3"
                                        Margin="10,2.5,0,0"
                                        MaxHeight="50"
                                        HorizontalAlignment="Right"
                                        x:Name="PART_EmployeeGroups"/>
                <Grid Grid.Column="4"
                      Margin="5,0,5,0">
                    <TextBlock Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               TextWrapping="Wrap"
                               MinWidth="55"
                               MaxWidth="75"
                               x:Name="PART_AuditoriesLabel"/>
                    <TextBlock Foreground="{DynamicResource Schedule.Text.Foreground.Static}"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Right"
                               x:Name="PART_SubgroupsLabel"/>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
    
</ResourceDictionary>